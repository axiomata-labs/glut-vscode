{
  "name": "glut",
  "displayName": "Glut",
  "description": "Glut beside VS Code: the file, the selection and your unsaved buffers go to Glut, its edits come back as VS Code diffs.",
  "version": "0.1.0",
  "publisher": "namorx68",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/axiomata-labs/glut-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "glut.open",
        "title": "Open Glut",
        "category": "Glut",
        "icon": "$(flame)"
      },
      {
        "command": "glut.send",
        "title": "Send Selection to Glut",
        "category": "Glut"
      },
      {
        "command": "glut.add",
        "title": "Add File to Glut",
        "category": "Glut"
      },
      {
        "command": "glut.acceptDiff",
        "title": "Accept Glut's Change",
        "category": "Glut",
        "icon": "$(check)"
      },
      {
        "command": "glut.denyDiff",
        "title": "Refuse Glut's Change",
        "category": "Glut",
        "icon": "$(close)"
      },
      {
        "command": "glut.backToFile",
        "title": "Back to the File",
        "category": "Glut"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "glut.acceptDiff",
          "when": "resourceScheme == glut-change || resourceScheme == glut-shown",
          "group": "navigation@1"
        },
        {
          "command": "glut.denyDiff",
          "when": "resourceScheme == glut-change || resourceScheme == glut-shown",
          "group": "navigation@2"
        },
        {
          "command": "glut.open",
          "when": "resourceScheme != glut-change && resourceScheme != glut-shown",
          "group": "navigation@9"
        }
      ],
      "editor/context": [
        {
          "command": "glut.send",
          "when": "editorHasSelection",
          "group": "glut@1"
        },
        {
          "command": "glut.add",
          "group": "glut@2"
        }
      ],
      "commandPalette": [
        {
          "command": "glut.acceptDiff",
          "when": "glut.diffShown"
        },
        {
          "command": "glut.denyDiff",
          "when": "glut.diffShown"
        },
        {
          "command": "glut.backToFile",
          "when": "glut.terminalActive"
        }
      ],
      "explorer/context": [
        {
          "command": "glut.add",
          "when": "!explorerResourceIsFolder",
          "group": "glut@1"
        }
      ]
    },
    "configuration": {
      "title": "Glut",
      "properties": {
        "glut.command": {
          "type": "string",
          "default": "glut",
          "description": "The program Glut is started as (a path or a name on the PATH). Only your user settings count: a folder's own settings never choose the program.",
          "scope": "machine"
        },
        "glut.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "description": "Where Glut's terminal opens: beside the editors, or in the panel."
        }
      }
    },
    "keybindings": [
      {
        "command": "glut.open",
        "key": "ctrl+alt+g",
        "mac": "alt+cmd+g",
        "when": "!(terminalFocus && glut.terminalActive)"
      },
      {
        "command": "glut.backToFile",
        "key": "ctrl+alt+g",
        "mac": "alt+cmd+g",
        "when": "terminalFocus && glut.terminalActive"
      },
      {
        "command": "workbench.action.terminal.sendSequence",
        "key": "cmd+k",
        "args": {
          "text": "\f"
        },
        "when": "terminalFocus && glut.terminalActive"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "glut",
          "title": "Glut",
          "icon": "media/glut.svg"
        }
      ]
    },
    "views": {
      "glut": [
        {
          "id": "glut.start",
          "name": "Glut"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "glut.start",
        "contents": "Glut runs in a terminal beside your files; this flame brings it to the front.\n[Open Glut](command:glut.open)\nWhat you select in a file goes to Glut with your next message by itself. To name it in your text:\n[Send Selection to Glut](command:glut.send)\n[Add File to Glut](command:glut.add)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mts",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.9.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you do not trust, Glut starts only as the program your user settings name.",
      "restrictedConfigurations": [
        "glut.command"
      ]
    }
  }
}
